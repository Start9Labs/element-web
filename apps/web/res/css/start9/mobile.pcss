/* Phones show one pane at a time: the room list, the room, or the right panel.
   Imported from the app entry rather than the theme index, so it stays outside the `app-web` cascade layer and
   overrides upstream's layered rules whatever their specificity; `!important` is only for inline styles.
   The breakpoint is shared with `usePhoneLayout`; move them together. */
@media (max-width: 767px) {
    /* LoggedInView's resizable pane group: no separator, and the visible pane takes the whole width. */
    .mx_MatrixChat > div > .mx_Separator {
        display: none;
    }

    .mx_MatrixChat > div > div:has(> .mx_LeftPanel_panel) {
        flex: 1 1 auto !important;
        min-width: 0 !important;
        max-width: none !important;
    }

    /* A room is open: the space rail and the list step aside. A space home or the home page counts as no room. */
    .mx_MatrixChat:has(.mx_RoomView) > div > .mx_SpacePanel,
    .mx_MatrixChat:has(.mx_RoomView) > div > div:has(> .mx_LeftPanel_panel > .mx_LeftPanel_outerWrapper),
    .mx_MatrixChat:not(:has(.mx_RoomView)) > div > div:has(> .mx_LeftPanel_panel > .mx_RoomView_wrapper) {
        display: none !important;
    }

    /* The right panel covers the room instead of splitting it; its cards already carry back and close buttons. */
    .mx_RightPanel_ResizeWrapper {
        position: fixed !important;
        inset: 0;
        width: auto !important;
        max-width: none !important;
        height: auto !important;
        z-index: 100;
    }

    .mx_RightPanel_ResizeWrapper .mx_ResizeHandle--horizontal {
        display: none;
    }

    /* Sign in, register and forgot-password: one column, the logo above the form, the card never wider than the
       screen. Upstream lays the modal out for 700px and only adapts below 480px. */
    .mx_AuthPage {
        height: 100dvh;
    }

    .mx_AuthPage_modal {
        width: calc(100% - 2 * var(--cpd-space-4x));
        max-width: 532px;
        margin: var(--cpd-space-6x) auto auto;
    }

    .mx_AuthPage_modalContent {
        flex-direction: column;
        align-items: center;
        width: 100%;
    }

    .mx_AuthHeader {
        display: flex;
        width: auto;
        padding: var(--cpd-space-8x) var(--cpd-space-6x) 0;
        align-items: center;
    }

    .mx_AuthHeaderLogo {
        display: block;
        margin: 0;
        padding: 0;
    }

    .mx_AuthHeaderLogo img {
        width: auto;
        max-width: 100%;
        max-height: 72px;
    }

    .mx_AuthBody,
    .mx_AuthBody.mx_AuthBody_forgot-password {
        width: 100%;
        max-width: 500px;
        min-height: 0;
        box-sizing: border-box;
        padding: var(--cpd-space-6x) var(--cpd-space-5x);
    }

    .mx_AuthBody_fieldRow {
        flex-direction: column;
    }

    .mx_AuthBody_fieldRow > .mx_Field {
        margin-inline: 0;
    }

    /* Dialogs fill the screen. */
    .mx_Dialog_border {
        width: 100%;
        max-width: 100%;
        height: 100%;
        max-height: 100%;
    }

    .mx_Dialog {
        width: 100%;
        height: 100%;
        max-width: none;
        max-height: none;
        border-radius: 0;
        padding: var(--cpd-space-4x);
    }

    .mx_Dialog_fixedWidth {
        width: 100%;
        max-width: none;
    }

    .mx_Dialog .mx_UserSettingsDialog,
    .mx_Dialog .mx_RoomSettingsDialog,
    .mx_Dialog .mx_SpaceSettingsDialog,
    .mx_Dialog .mx_SpacePreferencesDialog {
        width: 100%;
        max-width: none;
        height: 100%;

        .mx_TabbedView .mx_SettingsTab {
            min-width: 0;
            padding-right: var(--cpd-space-4x);
        }
    }
}
